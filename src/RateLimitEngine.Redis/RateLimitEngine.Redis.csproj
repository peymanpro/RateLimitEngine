<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RateLimitEngine.Core\RateLimitEngine.Core.csproj" />
    <ProjectReference Include="..\RateLimitEngine.Algorithms\RateLimitEngine.Algorithms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>RateLimitEngine.Redis</PackageId>
    <Description>Redis-backed distributed rate limiting infrastructure for RateLimitEngine.</Description>
    <PackageTags>rate-limiting;rate-limit;redis;distributed;lua;stackexchange-redis;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md"
          Pack="true"
          PackagePath="README.md" />
  </ItemGroup>

</Project>
